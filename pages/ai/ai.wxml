<view class="page">
  <view class="header">
    <view class="title">🤖 AI 智能助手</view>
  </view>
  
  <view class="chat-area">
    <scroll-view 
      class="chat-list" 
      scroll-y 
      scroll-into-view="{{scrollToView}}"
      scroll-with-animation
    >
      <view 
        class="chat-message {{item.role}}" 
        wx:for="{{messages}}" 
        wx:key="index"
        id="msg-{{index}}"
      >
        <view class="avatar" wx:if="{{item.role === 'bot'}}">🤖</view>
        <view class="bubble">{{item.content}}</view>
        <view class="avatar" wx:if="{{item.role === 'user'}}">👤</view>
      </view>
    </scroll-view>
  </view>
  
  <view class="input-area">
    <input 
      class="chat-input" 
      placeholder="请输入您的问题..." 
      bindinput="onInput" 
      value="{{inputValue}}"
      confirm-type="send"
      bindconfirm="sendMessage"
    />
    <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="sendMessage">发送</view>
  </view>
</view>
