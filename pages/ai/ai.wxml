<view class="page">
  <view class="header">
    <view class="header-content">
      <view class="title">🤖 AI 智能助手</view>
      <view class="subtitle">两航起义纪念馆</view>
    </view>
    <view class="clear-btn" bindtap="clearChat">清空</view>
  </view>
  
  <view class="chat-area">
    <scroll-view 
      class="chat-list" 
      scroll-y 
      scroll-into-view="{{scrollToView}}"
      scroll-with-animation
    >
      <!-- 欢迎消息 -->
      <view class="welcome-tip" wx:if="{{messages.length <= 1}}">
        <view class="tip-title">💡 您可以这样问我：</view>
        <view class="tip-list">
          <view class="tip-item" wx:for="{{quickQuestions}}" wx:key="*this" bindtap="sendQuickQuestion" data-question="{{item}}">
            {{item}}
          </view>
        </view>
      </view>

      <!-- 消息列表 -->
      <view 
        class="chat-message {{item.role}}" 
        wx:for="{{messages}}" 
        wx:key="index"
        id="msg-{{index}}"
      >
        <view class="avatar" wx:if="{{item.role === 'bot'}}">🤖</view>
        <view class="msg-wrap">
          <view class="bubble">
            <text>{{item.content}}</text>
            <!-- 操作按钮 -->
            <view class="action-btn" wx:if="{{item.action}}" bindtap="handleAction" data-action="{{item.action}}">
              {{item.action.label}} →
            </view>
          </view>
          <view class="time">{{item.time}}</view>
        </view>
        <view class="avatar" wx:if="{{item.role === 'user'}}">👤</view>
      </view>

      <!-- 打字动画 -->
      <view class="chat-message bot" wx:if="{{isTyping}}">
        <view class="avatar">🤖</view>
        <view class="typing-bubble">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
    </scroll-view>
  </view>
  
  <!-- 输入区域 -->
  <view class="input-area {{isFocused ? 'focused' : ''}}">
    <!-- 快捷操作栏 -->
    <view class="quick-bar">
      <view class="quick-action" bindtap="sendQuickQuestion" data-question="两航起义是什么？">
        <text class="quick-icon">📜</text>
        <text class="quick-text">起义历史</text>
      </view>
      <view class="quick-action" bindtap="sendQuickQuestion" data-question="纪念馆在哪？">
        <text class="quick-icon">📍</text>
        <text class="quick-text">位置</text>
      </view>
      <view class="quick-action" bindtap="sendQuickQuestion" data-question="开放时间？">
        <text class="quick-icon">🕐</text>
        <text class="quick-text">时间</text>
      </view>
      <view class="quick-action" bindtap="sendQuickQuestion" data-question="怎么去？">
        <text class="quick-icon">🚗</text>
        <text class="quick-text">交通</text>
      </view>
    </view>
    
    <!-- 文本输入框 -->
    <view class="input-box">
      <view class="input-wrapper">
        <textarea 
          class="chat-textarea" 
          placeholder="请输入您的问题，如：两航起义的历史意义是什么？" 
          placeholder-class="placeholder"
          bindinput="onInput" 
          bindfocus="onFocus"
          bindblur="onBlur"
          value="{{inputValue}}"
          auto-height
          maxlength="500"
          show-confirm-button="{{false}}"
          disable-default-padding
        />
        <view class="char-count" wx:if="{{inputValue.length > 0}}">
          {{inputValue.length}}/500
        </view>
      </view>
      <view class="send-area">
        <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="sendMessage">
          <text class="send-icon">↑</text>
        </view>
      </view>
    </view>
  </view>
</view>
