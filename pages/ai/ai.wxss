.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #b82626, #d44444);
  padding: 30rpx;
  color: #fff;
  text-align: center;
  flex-shrink: 0;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
}

.chat-area {
  flex: 1;
  overflow: hidden;
}

.chat-list {
  height: 100%;
  padding: 20rpx;
}

.chat-message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.chat-message.user {
  justify-content: flex-end;
}

.avatar {
  font-size: 44rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bubble {
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  max-width: 70%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  word-break: break-all;
}

.chat-message.user .bubble {
  background: #b82626;
  color: #fff;
}

.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  flex-shrink: 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  background: #ccc;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  flex-shrink: 0;
}

.send-btn.active {
  background: #b82626;
}
