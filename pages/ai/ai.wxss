.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f0f0f0;
}

/* 头部样式 */
.header {
  background: linear-gradient(135deg, #b82626, #d44444);
  padding: 24rpx 30rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  padding-top: calc(24rpx + env(safe-area-inset-top));
}

.header-content {
  flex: 1;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
}

.subtitle {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

.clear-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

/* 聊天区域 */
.chat-area {
  flex: 1;
  overflow: hidden;
}

.chat-list {
  height: 100%;
  padding: 20rpx;
}

/* 快捷提示 */
.welcome-tip {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tip-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.tip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tip-item {
  background: #f5f5f5;
  color: #b82626;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid #eee;
}

.tip-item:active {
  background: #b82626;
  color: #fff;
}

/* 消息样式 */
.chat-message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.chat-message.user {
  justify-content: flex-end;
}

.avatar {
  font-size: 40rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-wrap {
  max-width: 75%;
}

.bubble {
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  word-break: break-all;
  line-height: 1.6;
}

.chat-message.user .bubble {
  background: #b82626;
  color: #fff;
}

.time {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
}

.chat-message.user .time {
  text-align: right;
}

/* 操作按钮 */
.action-btn {
  display: inline-block;
  margin-top: 16rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #b82626, #d44444);
  color: #fff;
  font-size: 24rpx;
  border-radius: 20rpx;
}

.action-btn:active {
  opacity: 0.8;
}

/* 打字动画 */
.typing-bubble {
  background: #fff;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #999;
  border-radius: 50%;
  animation: typing 1.4s infinite;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-10rpx);
    opacity: 1;
  }
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
  flex-shrink: 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.quick-btn {
  font-size: 36rpx;
  padding: 10rpx;
  margin-right: 12rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  background: #ddd;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  flex-shrink: 0;
}

.send-btn.active {
  background: #b82626;
}
