.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #b82626, #d44444);
  padding: 40rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.sub-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.content-box {
  margin: 24rpx;
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.pic {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.paragraph {
  font-size: 30rpx;
  color: #333;
  line-height: 2;
  display: block;
  margin-bottom: 24rpx;
  text-indent: 2em;
}

.paragraph:last-child {
  margin-bottom: 0;
}

.back-btn {
  margin: 30rpx 24rpx 60rpx;
  background: #b82626;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.back-btn:active {
  opacity: 0.8;
}
