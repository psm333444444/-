.container{
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.title{
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom:10rpx;
  color:#991b1b;
}

.sub-title{
  font-size:28rpx;
  text-align:center;
  color:#666;
  margin-bottom:40rpx;
}

.content-box{
  background:#ffffff;
  padding:40rpx 30rpx;
  border-radius:16rpx;
  line-height:2;
}

.paragraph{
  font-size:30rpx;
  color:#333;
  display:block;
  margin-bottom:30rpx;
}

.back-btn{
  margin-top:60rpx;
  background-color:#b82626;
  color:#ffffff;
}