.box{
  width:100%;
  min-height:100vh;
  background-color:#f8f8f8;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  padding:40rpx;
}

.btn-item{
  width:70%;
  margin-bottom:60rpx;
}

.btn-item button{
  background-color:#b82626;
  color:#ffffff;
  border-radius:16rpx;
  box-shadow: 0 6rpx 12rpx rgba(150,20,20,0.25);
}
.home-img{
  width:100%;
  height:400rpx;
  object-fit:cover;
}