<view class="page">
  <view class="header">
    <view class="avatar-wrap">
      <image 
        class="avatar" 
        src="{{userInfo.avatarUrl || ''}}" 
        mode="aspectFill" 
        wx:if="{{userInfo}}"
      />
      <view class="avatar default-avatar" wx:else>👤</view>
    </view>
    <view class="nickname">{{userInfo.nickName || '未登录'}}</view>
    <view class="login-btn" bindtap="getUserProfile" wx:if="{{!userInfo}}">点击登录</view>
  </view>
  
  <view class="content">
    <view class="menu-group">
      <view class="menu-item" bindtap="goHistory">
        <text class="menu-icon">📖</text>
        <text class="menu-text">两航起义历史</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goQuiz">
        <text class="menu-icon">❓</text>
        <text class="menu-text">知识问答</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goFavorite">
        <text class="menu-icon">⭐</text>
        <text class="menu-text">我的收藏</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    
    <view class="menu-group">
      <view class="menu-item" bindtap="goFeedback">
        <text class="menu-icon">💬</text>
        <text class="menu-text">意见反馈</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="logout-btn" bindtap="logout" wx:if="{{userInfo}}">退出登录</view>
  </view>
</view>
