.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.header {
  background: linear-gradient(135deg, #b82626, #d44444);
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
}

.avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 20rpx;
  background: rgba(255, 255, 255, 0.3);
}

.avatar {
  width: 100%;
  height: 100%;
}

.default-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

.nickname {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.login-btn {
  display: inline-block;
  background: rgba(255, 255, 255, 0.9);
  color: #b82626;
  font-size: 26rpx;
  border-radius: 30rpx;
  padding: 12rpx 40rpx;
}

.content {
  padding: 20rpx;
}

.menu-group {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f9f9f9;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.logout-btn {
  margin-top: 40rpx;
  background: #fff;
  color: #e74c3c;
  text-align: center;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.logout-btn:active {
  background: #f9f9f9;
}
