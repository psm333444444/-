.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #1a1a1a;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.2);
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 10rpx 0;
}

.tab-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tab-icon {
  font-size: 36rpx;
  color: #ffffff;
  opacity: 0.6;
  transition: all 0.2s ease;
}

.tab-icon.icon-active {
  opacity: 1;
  color: #ffffff;
  transform: scale(1.1);
}

.tab-text {
  font-size: 20rpx;
  color: #ffffff;
  opacity: 0.6;
}

.tab-bar-item.active .tab-text {
  opacity: 1;
  font-weight: bold;
  color: #ffffff;
}

/* 选中时的底部指示器 */
.tab-bar-item.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background: #b82626;
  border-radius: 2rpx;
}
